# ─── Base de datos ───────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/ips_asistente

# ─── Auth ────────────────────────────────────────────────────────
JWT_SECRET=cambiar-por-un-secret-seguro-de-64-chars-minimo
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cifrado en reposo de campos sensibles ───────────────────────
# Cifra PatientNote.content y Message.content en la DB (prisma-field-encryption).
# Generar con: npx cloak generate   (formato k1.aesgcm256.<base64>)
# CRÍTICO: si se pierde esta clave, los datos cifrados son IRRECUPERABLES.
# Producción: clave distinta a la de dev/test, guardada solo en el secret store.
PRISMA_FIELD_ENCRYPTION_KEY=k1.aesgcm256.generar-con-npx-cloak-generate

# ─── Mensajería (proveedor) ──────────────────────────────────────
# 'meta' (default, Meta Cloud API) o 'twilio' (Twilio WhatsApp/Sandbox)
MESSAGING_PROVIDER=meta

# ─── WhatsApp (Meta Cloud API) ───────────────────────────────────
WHATSAPP_ACCESS_TOKEN=tu-token-de-meta
WHATSAPP_PHONE_NUMBER_ID=tu-phone-number-id
WHATSAPP_VERIFY_TOKEN=un-string-cualquiera-para-verificacion
WHATSAPP_APP_SECRET=tu-app-secret-de-meta

# ─── WhatsApp via Twilio (alternativa a Meta) ────────────────────
# Solo necesario si MESSAGING_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu-auth-token-de-twilio
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── AI (Anthropic) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# ─── Server ──────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── Cron ────────────────────────────────────────────────────────
# Hora de envío de recordatorios (formato cron, default 8:00 AM Argentina UTC-3 = 11:00 UTC)
REMINDER_CRON=0 11 * * *
